   "narrate": false,
   "show": 9
  },
  {
   "ms": 20395,
   "lastMs": 20395,
   "screen": "cutscene",
   "speaker": "Seymour",
   "role": "Maester",
   "text": "You talk about him when you think no one listens.",
   "portrait": "seymour.webp",
   "narrate": false,
   "show": 10
  },
  {
   "ms": 20412,
   "lastMs": 20412,
   "screen": "cutscene",
   "speaker": "Seymour",
   "role": "Maester",
   "text": "So let me give you what no one else will.",
   "portrait": "seymour.webp",
   "narrate": false,
   "show": 11
  },
  {
   "ms": 20429,
   "lastMs": 20445,
   "screen": "cutscene",
   "speaker": "Seymour",
   "role": "Maester",
   "text": "Your father is Sin.",
