   "show": 6
  },
  {
   "ms": 20346,
   "lastMs": 20346,
   "screen": "cutscene",
   "speaker": "Seymour",
   "role": "Maester",
   "text": "They refused comfort. I offered it anyway.",
   "portrait": "seymour.webp",
   "narrate": false,
