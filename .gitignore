node_modules/
dist/
.vite/
*.log
.DS_Store
Thumbs.db
# local-only hi-fi asset drop-in (never committed)
public/assets/hifi/
# playwright / critic outputs
test-results/
playwright-report/
critic/screens/
# sprite / tool render output
build/
# pre-cutout renders and rejected batch variants from tools/gen/comfy.mjs
public/art/**/*.raw.png
public/art/**/*.[0-9].png
public/art/**/*.[0-9].json
__pycache__/

# yaw-key pilot candidates (tools/gen/yaw-keys.mjs): dozens of raw renders per
# round, kept locally for review only. The picked two per key live curated
# and converted to WebP under prototype-v2/art/keys/picked/ (see keys.md).
docs/concepts/pause-until-dawn/prototype-v2/art/keys/_cand/

# ---------------------------------------------------------------------------
# Generated binaries: regenerable, large, and rewritten under the same names on
# every run, so git history is the wrong place for them.
#
# Painted art from tools/gen/comfy.mjs. The art track re-renders these hourly;
# the real backup is robocopy snapshots under D:\Tools\pyrefly-art-backup\.
public/art/
#
# Audio previews from tools/render-track.mjs (~10 MB each). Nothing ships as an
# audio file — the game synthesises everything at runtime — so these are
# previews only and regenerate with `node tools/render-track.mjs all`.
# (Four early previews were committed before this rule and remain tracked.)
docs/audio/*.wav
# Audition copies from `npm run audio:render -- --audition`: byte-identical to
# what already ships in public/audio/, kept only for listening locally.
docs/audio/audition/

# End-state board from `node tools/end-state-board.mjs`: ~2 MB of inlined
# pictures, regenerated from docs/target/targets.json (which IS tracked).
docs/target/board.html

# local release zips and release build output
releases/
dist-release/

# scratch harnesses and probe dumps
critic/scratch/

# critic round evidence (screenshots, harnesses): reports are tracked, evidence folders are not
critic/rounds/*/
